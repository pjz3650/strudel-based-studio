{
  "name": "live-studio",
  "version": "0.1.0",
  "description": "Estúdio desktop de live coding musical com Strudel",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "license": "AGPL-3.0-or-later",
  "author": "Live Studio contributors",
  "repository": "https://github.com/pjz3650/strudel-based-studio",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "dist": "pnpm build && electron-builder --win nsis portable --publish never",
    "pack": "pnpm build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.4",
    "@codemirror/commands": "6.8.0",
    "@codemirror/lang-javascript": "6.2.2",
    "@codemirror/language": "6.10.8",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@lezer/highlight": "1.2.1",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/midi": "1.3.0",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "lucide": "0.468.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "electron": "45.0.0",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.1",
    "rcedit": "5.0.2",
    "typescript": "5.8.2",
    "vite": "6.2.6",
    "vitest": "3.0.9"
  },
  "build": {
    "appId": "org.live-studio.desktop",
    "productName": "Live Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icon.ico",
      "assets/fonts/LICENSE.txt",
      "LICENSE",
      "LICENSE.initial-MIT",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Live-Studio-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Live-Studio-${version}-${arch}-portable.${ext}"
    }
  }
}
